# syntax=docker/dockerfile:1
#
# The API image for Vercel. Unlike the root Dockerfile it carries no frontend:
# on Vercel the UI is its own static service, so building it in here would only
# make every deploy slower and every cold start pull a bigger image.

FROM node:22-bookworm-slim

# FFmpeg with libzimg, which the zscale tone-mapping chain depends on.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY server.js ./

# /tmp is the one place a function instance can reliably write. Working files
# are deleted per job and the whole directory goes on SIGTERM.
ENV DATA_DIR=/tmp/hdr2sdr
RUN mkdir -p /tmp/hdr2sdr && chown -R node:node /tmp/hdr2sdr /app

USER node

# Defaults sized for a 1 vCPU Hobby instance with a 300s limit. Override any
# of them in the project's environment variables, e.g. MAX_DURATION_SECONDS=800
# on Pro once the function's max duration is raised to match.
ENV NODE_ENV=production \
    PORT=3001 \
    HOST=0.0.0.0 \
    MAX_DURATION_SECONDS=300 \
    MAX_UPLOAD_MB=200 \
    VIDEO_PRESET=veryfast \
    MAX_CONCURRENT_JOBS=1 \
    JOB_TTL_MINUTES=15

EXPOSE 3001

CMD ["node", "server.js"]
