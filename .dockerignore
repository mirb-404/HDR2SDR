# Build artefacts and dependencies are produced inside the image.
node_modules
**/node_modules
frontend/dist
backend/.data
backend/uploads
backend/outputs

# Never ship these into an image.
.env
.env.*
!.env.example
.git
.gitignore
**/*.log

# Docs and local tooling add nothing to the runtime.
*.md
!README.md
.github
.vscode
.idea
