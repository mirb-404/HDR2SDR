# Copy to .env and adjust. Every value here is optional — the defaults are
# already tuned for a small free-tier container.

# ── Network ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0

# Number of reverse proxies in front of the app. Almost every host puts exactly
# one there. Getting this wrong makes every client share a rate-limit bucket.
TRUST_PROXY_HOPS=1

# Send HSTS. Only turn this on once HTTPS actually works, or browsers will
# refuse to load the site over HTTP for a year.
FORCE_HSTS=false

# Only needed if the frontend is hosted on a different origin to the API.
# ALLOWED_ORIGIN=https://hdr2sdr.example.com

# ── Limits ───────────────────────────────────────────────────────────────────
# Shown in the UI and enforced by the server. The UI reads this from
# /api/config, so changing it here updates the site text too.
MAX_UPLOAD_MB=500

# One encode at a time is right for a 1-2 core free instance: FFmpeg already
# uses every core, so running two just makes both slower.
MAX_CONCURRENT_JOBS=1
MAX_QUEUED_JOBS=3

# How long anything may sit on disk before it is deleted no matter what.
JOB_TTL_MINUTES=15

# Kill an encode that runs longer than this so one huge file cannot hold the
# queue forever.
FFMPEG_TIMEOUT_MINUTES=30

# ── Abuse limits (per client, sliding window) ────────────────────────────────
RATE_UPLOADS=5
RATE_API=120

# ── Encoding ─────────────────────────────────────────────────────────────────
# Lower CRF is higher quality and a bigger file. 20 is just above the point
# where the re-encode becomes visible. Raise to 23 to halve the file size.
VIDEO_CRF=20

# Slower presets compress better for the same quality. On a shared free vCPU,
# 'fast' or 'veryfast' is the difference between a wait and a timeout.
VIDEO_PRESET=fast
AUDIO_BITRATE=192k

# ── Paths ────────────────────────────────────────────────────────────────────
# Transient working files. On an ephemeral host, /tmp is ideal — the disk being
# wiped on restart is a feature here.
# DATA_DIR=/data
# FFMPEG_PATH=ffmpeg
